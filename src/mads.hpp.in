/**
 * @brief AgentError exception class.
 *
 */
#ifndef SWIG
class AgentError : public std::exception {
public:
  AgentError(std::string msg) : _msg(msg) {}
  const char *what() const noexcept override { return _msg.c_str(); }

private:
  std::string _msg;
};
#endif

