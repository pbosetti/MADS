namespace Mads {

/**
 * @brief Library version.
 *
 */
inline std::string version() { return LIB_VERSION; }

/**
 * @brief Checks if the given version matches the library version.
 *
 * @param version The version string to check.
 * @return true if the version matches, false otherwise.
 * @throws std::runtime_error if the version string is invalid.
 */
inline bool check_version(const std::string &version) {
  size_t last_dot = version.find_last_of('.');
  std::string version_cmp;
  if (last_dot != std::string::npos) {
    version_cmp = version.substr(0, last_dot);
    return version_cmp == LIB_VERSION_CHECK;
  } else {
    throw std::runtime_error("Invalid version string: " + version);
  }
}

/**
 * @brief Run-state owner for agent loops.
 *
 * A Runtime holds the "keep going" state consulted by Agent::loop(), the
 * delivery drain thread, and similar long-running constructs. Every Agent
 * owns its own Runtime by default, so stopping or destroying one agent never
 * affects the others hosted in the same process; agents that should stop
 * together can be grouped by sharing one Runtime (Agent::set_runtime()), and
 * the whole group is then stopped with a single Runtime::stop().
 *
 * Two levels of stopping exist:
 * - Runtime::stop() stops the agents attached to that Runtime only;
 * - Runtime::stop_process() (used by signal handlers and the remote
 *   "shutdown"/"restart" commands) stops every Runtime in the process.
 *
 * running() reports true only if neither level has been stopped.
 */
class Runtime {
public:
  /// True until this Runtime is stopped or a process-wide stop occurred.
  bool running() const noexcept {
    return _running.load() && process_running().load();
  }
  /// Stop the loops of the agents attached to this Runtime.
  void stop() noexcept { _running.store(false); }
  /// Re-arm this Runtime (does not undo a process-wide stop).
  void reset() noexcept { _running.store(true); }

  /// Process-wide run flag, shared by all Runtimes (async-signal-safe).
  static std::atomic<bool> &process_running() noexcept {
    static std::atomic<bool> flag{true};
    return flag;
  }
  /// Request a process-wide stop: every Runtime's running() becomes false.
  static void stop_process() noexcept { process_running().store(false); }

private:
  std::atomic<bool> _running{true};
};

/**
 * @brief Global flag for stopping the main loop in Mads agents.
 *
 * @deprecated Superseded by Mads::Runtime. This remains a working alias of
 * the process-wide run flag: writing false still stops every agent in the
 * process, and reading it reports the process-wide state. Prefer
 * agent.runtime()->stop() to stop a single agent, or
 * Mads::Runtime::stop_process() for a process-wide stop.
 */
[[deprecated("use Mads::Runtime (agent.runtime()->stop() or "
             "Mads::Runtime::stop_process()) instead of the process-global "
             "Mads::running flag")]]
inline std::atomic<bool> &running = Runtime::process_running();

/**
 * @brief Enumeration of event types for agents.
 *
 */
enum class event_type {
  marker = 0,
  marker_in,
  marker_out,
  startup,
  shutdown,
  message
};

/**
 * @brief Enumeration of message types for agents.
 *
 */
enum class message_type { none = 0, json = 1, blob, error };

/**
 * @brief On-the-wire payload encoding.
 *
 * `Json` reproduces the historical format (snappy-compressed JSON text, no
 * frame header) and stays byte-compatible with pre-existing agents. `MsgPack`
 * emits a self-describing frame header (see agent.cpp) and encodes the payload
 * as MessagePack. Readers transparently accept both, so the choice only affects
 * what an agent *publishes*.
 */
enum class WireFormat { Json = 0, MsgPack = 1 };

/**
 * @brief Payload compression policy applied before sending.
 *
 * `None` never compresses, `Snappy` always compresses, `Auto` compresses only
 * payloads at or above COMPRESSION_AUTO_THRESHOLD bytes (so tiny control/status
 * frames are sent uncompressed while large frames keep today's behaviour).
 *
 * A non-Snappy choice is recorded in the frame header so the receiver can
 * decode it; legacy header-less frames are therefore always Snappy.
 */
enum class Compression { None = 0, Snappy = 1, Auto = 2 };

/**
 * @brief Subscriber delivery semantics.
 *
 * `Queued` keeps the ZMQ receive queue (bounded by the high-water mark).
 * `LastKnownValue` keeps only the most recent message (LKV), draining older
 * ones on a background thread.
 */
enum class Delivery { Queued = 0, LastKnownValue = 1 };

/**
 * @brief Default timeouts and delays (milliseconds).
 *
 * Named replacements for the historical magic numbers scattered through the
 * agent implementation.
 */
inline constexpr int DEFAULT_RECEIVE_TIMEOUT_MS = 500;
inline constexpr int DEFAULT_SETTINGS_TIMEOUT_MS = 2000;
inline constexpr int STARTUP_SHUTDOWN_DELAY_MS = 500;

/**
 * @brief Size (bytes) at or above which `Compression::Auto` compresses.
 *
 * Below this, snappy framing overhead is not worth the CPU (and can enlarge the
 * payload), so small frames are sent uncompressed.
 */
inline constexpr size_t COMPRESSION_AUTO_THRESHOLD = 256;

/**
 * @brief Map of event types to strings.
 *
 */
inline const std::map<event_type, std::string> event_map = {
    {event_type::marker, "marker"},
    {event_type::marker_in, "marker in"},
    {event_type::marker_out, "marker out"},
    {event_type::startup, "startup"},
    {event_type::shutdown, "shutdown"},
    {event_type::message, "message"},
};

// This results in duplicate definition link error in the GUI
#ifndef MADS_QAGENT_H
inline std::string event_name(event_type type) { return event_map.at(type); }
#endif // MADS_QAGENT_H

/**
 * @brief Get the ISODate time object
 *
 * @param time
 * @return string
 */
inline std::string
get_ISODate_time(const std::chrono::system_clock::time_point &time,
                 int32_t offset = 0) {
  const auto adjusted_time = time + std::chrono::milliseconds(offset);
  const auto truncated_time =
      std::chrono::floor<std::chrono::seconds>(adjusted_time);
  time_t tt = std::chrono::system_clock::to_time_t(truncated_time);
  tm *tt2 = localtime(&tt);
  std::stringstream ss;

  long long ms = std::chrono::duration_cast<std::chrono::milliseconds>(
                     adjusted_time - truncated_time)
                     .count();

  ss << std::put_time(tt2, "%FT%T")                    // "2023-03-30T19:49:53"
     << "." << std::setw(3) << std::setfill('0') << ms // ".005"
     << std::put_time(tt2, "%z"); // "+0200" (time zone offset, optional)

  return ss.str();
}

inline double timecode(const std::chrono::system_clock::time_point &now,
                       unsigned int fps = 25) {
  time_t now_c = std::chrono::system_clock::to_time_t(now);
  tm *lt = localtime(&now_c);
  double fct = 1000.0 / fps;
  auto tt = std::chrono::system_clock::from_time_t(now_c);
  long long ms =
      std::chrono::duration_cast<std::chrono::milliseconds>(now - tt).count();
  ms = static_cast<long long>(floor(ms / fct) * fct); // Round to the nearest 25ms

  return lt->tm_hour * 3600 + lt->tm_min * 60 + lt->tm_sec + ms / 1000.0;
}

#ifndef _WIN32
inline std::chrono::milliseconds tv_to_milliseconds(struct timeval &tv)
{
    using namespace std::chrono;

    auto sec  = duration_cast<milliseconds>(seconds(tv.tv_sec));
    auto usec = duration_cast<milliseconds>(microseconds(tv.tv_usec));
    return sec + usec;
}

inline void milliseconds_to_tv(std::chrono::milliseconds const &ms,
                        struct timeval &tv)
{
    using namespace std::chrono;

    auto sec  = duration_cast<seconds>(ms);
    auto rem  = ms - duration_cast<milliseconds>(sec);

    tv.tv_sec  = static_cast<time_t>(sec.count());
    #ifdef _WIN32
    tv.tv_usec = static_cast<long>(
        duration_cast<microseconds>(rem).count()
    );
    #else
    tv.tv_usec = static_cast<suseconds_t>(
        duration_cast<microseconds>(rem).count()
    );
    #endif
}
#endif

